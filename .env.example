# Banco de dados — Supabase (PostgreSQL)
# Transaction pooler, porta 6543. Senha com caracteres especiais precisa de URL-encoding (@ -> %40).
DATABASE_URL="postgresql://postgres.<project-ref>:<senha-url-encoded>@aws-0-<regiao>.pooler.supabase.com:6543/postgres"

# Supabase API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Origem padrão (rótulo de campanha quando não vem na URL)
# NEXT_PUBLIC_ORIGEM_PADRAO=organico

# Pagamento (etapas 7+)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Deploy (Vercel)
# VERCEL_TOKEN=
# VERCEL_PROJECT_NAME=perfil-disc
# DOMINIO=disc.elseverconsulting.com.br